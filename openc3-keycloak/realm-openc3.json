{
  "realm": "openc3",
  "enabled": true,
  "displayName": "WarpLink",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "failureFactor": 10,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "passwordPolicy": "length(12) and notUsername(undefined) and passwordHistory(3)",
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Full access, including simulation control and user administration"
      },
      {
        "name": "operator",
        "description": "Send commands and run scripts on flight targets, but not simulation control"
      },
      {
        "name": "viewer",
        "description": "Read-only access to telemetry and scripts"
      }
    ]
  },
  "clients": [
    {
      "clientId": "openc3-api",
      "name": "OpenC3 COSMOS",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "http://localhost:2900/*",
        "https://localhost:2943/*"
      ],
      "webOrigins": [
        "+"
      ],
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "roles",
        "email"
      ]
    }
  ],
  "displayNameHtml": "<div class=\"kc-logo-text\"><span>WarpLink</span></div>",
  "loginTheme": "warplink"
}
