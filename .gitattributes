# Every text file checks out with LF on every platform, Windows included.
#
# This repo builds Linux containers from its own source tree, so a CRLF that
# reaches a shell script, a Ruby or Python entrypoint (openc3/bin/openc3cli,
# bin/rails), or a plugin .txt breaks the build or the plugin install. Git for
# Windows defaults to core.autocrlf=true, which would rewrite every file it
# considers text, so pin the line endings here rather than relying on each
# developer's config.
#
# text=auto lets Git detect binaries by content and leave them untouched.
* text=auto eol=lf

# Windows-only files that must keep CRLF to run.
*.bat text eol=crlf

# Never apply any conversion to these, whatever the content heuristic decides.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.eot  binary
*.ttf  binary
*.woff binary
*.woff2 binary
*.gz   binary
*.zip  binary
*.bin  binary
*.gem  binary
*.pdf  binary
*.vsix binary
openc3-cosmos-init/mc binary
openc3-ruby/anycable-go-linux-* binary
