        {
            "name": "Flight Executive",
            "short_name": "EXECUTIVE",
            "app_file": "flight/FlightExecutive",
            "description": "Flight scheduler and executive for managing app execution.",
            "apid_base": 0,
            "instances": [
                {
                    "instance": 0,
                    "scheduled_rate_hz": 0
                }
            ],
            "telemetry": [
                {
                    "name": "STATUS",
                    "apid": 1,
                    "apid_macro": "TLM_EXECUTIVE_STATUS",
                    "description": "Overall system status packet.",
                    "registrations": [
                        {
                            "instance": 0,
                            "rate_sec": 1.0,
                            "priority": "NORMAL"
                        }
                    ],
                    "fields": [
                        {
                            "id": "system_time",
                            "type": "float32",
                            "array_length": 0,
                            "description": "Current system time onboard the spacecraft, zero at power-on.",
                            "units": "s"
                        },
                        {
                            "id": "loop_count",
                            "type": "uint32",
                            "array_length": 0,
                            "description": "Number of cycles the onboard system schedule has executed."
                        },
                        {
                            "id": "error_count",
                            "type": "uint8",
                            "array_length": 0,
                            "description": "Total number of error returns in the code, rolls over at 255."
                        },
                        {
                            "id": "warning_count",
                            "type": "uint8",
                            "array_length": 0,
                            "description": "Total number of warning returns in the code, rolls over at 255."
                        },
                        {
                            "id": "overrun_count",
                            "type": "uint8",
                            "array_length": 0,
                            "description": "Total number of schedule overruns, rolls over at 255."
                        }
                    ]
                },
                {
                    "name": "APP_ERROR",
                    "apid": 2,
                    "apid_macro": "TLM_EXECUTIVE_APP_ERROR",
                    "description": "App error tracking packet, produced when an app returns error or warning.",
                    "registrations": [
                        {
                            "instance": 0,
                            "rate_sec": 1.0,
                            "priority": "NORMAL"
                        }
                    ],
                    "fields": [
                        {
                            "id": "app_apid",
                            "type": "uint16",
                            "array_length": 0,
                            "description": "The APID of the app returning error."
                        },
                        {
                            "id": "error_code",
                            "type": "int16",
                            "array_length": 0,
                            "description": "The error code returned by the app."
                        },
                        {
                            "id": "schedule_slot",
                            "type": "int16",
                            "array_length": 0,
                            "description": "The schedule slot where the error occurred; negative values represent startup."
                        }
                    ]
                },
                {
                    "name": "SCHEDULE_OVERRUN",
                    "apid": 3,
                    "apid_macro": "TLM_EXECUTIVE_SCHEDULE_OVERRUN",
                    "description": "Schedule overrun tracking packet, produced when an app overruns its schedule slot.",
                    "registrations": [
                        {
                            "instance": 0,
                            "rate_sec": 1.0,
                            "priority": "NORMAL"
                        }
                    ],
                    "fields": [
                        {
                            "id": "app_apid",
                            "type": "uint16",
                            "array_length": 0,
                            "description": "The APID of the app which overran."
                        },
                        {
                            "id": "schedule_slot",
                            "type": "int16",
                            "array_length": 0,
                            "description": "The schedule slot the app was scheduled for."
                        },
                        {
                            "id": "terminating_slot",
                            "type": "int16",
                            "array_length": 0,
                            "description": "The schedule slot where the app actually returned."
                        }
                    ]
                }
            ],
            "commands": []
        },
